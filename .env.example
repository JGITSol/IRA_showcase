# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database Configuration
# -------------------
# Database driver: postgresql or sqlite
DB_DRIVER=postgresql

# Database connection settings
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=insurance_risk

# Connection pool settings
POOL_SIZE=10
POOL_OVERFLOW=20
POOL_RECYCLE=3600

# SQL logging (set to true for development, false in production)
SQL_ECHO=false

# Legacy settings (for backward compatibility)
DATABASE_URL=postgresql://postgres:postgres@db:5432/insurance_risk
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=insurance_risk

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours
REFRESH_TOKEN_EXPIRE_DAYS=30

# First Superuser
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changeme

# Email
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
EMAILS_FROM_EMAIL=no-reply@example.com
EMAILS_FROM_NAME="Insurance Risk Analyzer"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# ML Model
MODEL_PATH=/app/models/insurance_model.pkl

# Frontend
FRONTEND_URL=http://localhost:3000
